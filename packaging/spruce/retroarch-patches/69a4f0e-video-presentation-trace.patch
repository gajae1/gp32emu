+/* Diagnostic only: one writer per array, read after worker joins. */
+#define GP32_PRESENT_CAPACITY 4096
+struct gp32_present_event {
+   uint64_t frame, start_ns, ready_ns, end_ns;
+   unsigned accepted;
+};
+struct gp32_present_trace {
+   struct gp32_present_event submit[GP32_PRESENT_CAPACITY];
+   struct gp32_present_event present[GP32_PRESENT_CAPACITY];
+   size_t submitted, presented, submit_overflow, present_overflow;
+};
+static uint64_t gp32_present_ns(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000000000u + t.tv_nsec;
+}
+static void gp32_present_dump(thread_video_t *thr)
+{
+   const char *path = getenv("GP32_PRESENT_LOG");
+   struct gp32_present_trace *trace = thr->gp32_trace;
+   if (path)
+   {
+      FILE *f = fopen(path, "w");
+      if (f)
+      {
+         size_t i;
+         fprintf(f, "# allocated=%d submit_overflow=%zu present_overflow=%zu\n",
+               trace != NULL, trace ? trace->submit_overflow : 0,
+               trace ? trace->present_overflow : 0);
+         fprintf(f, "kind,frame,start_ns,ready_ns,end_ns,accepted\n");
+         if (trace)
+            for (i = 0; i < trace->submitted + trace->presented; ++i)
+            {
+               int submit = i < trace->submitted;
+               struct gp32_present_event *e = submit ? &trace->submit[i]
+                  : &trace->present[i - trace->submitted];
+               fprintf(f, "%s,%llu,%llu,%llu,%llu,%u\n", submit ? "submit" : "present",
+                     (unsigned long long)e->frame, (unsigned long long)e->start_ns,
+                     (unsigned long long)e->ready_ns, (unsigned long long)e->end_ns,
+                     e->accepted);
+            }
+         fclose(f);
+      }
+   }
+   free(trace);
+   thr->gp32_trace = NULL;
+}
 
