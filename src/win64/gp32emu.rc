#include <windows.h>
#include "gp32_win64_ui.h"
#define IDI_GP32EMU 101
IDI_GP32EMU ICON "../../resources/gp32emu.ico"

/* Common Controls v6, UTF-8 active code page and long path awareness.  The
   UTF-8 code page keeps the existing A-suffixed Win32 path calls correct for
   Korean and other non-ACP filenames. */
1 24 "gp32emu.manifest"

IDD_KEYBOARD DIALOGEX 0, 0, 285, 226
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard controls"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Click a control, then press a key. Duplicate keys are swapped.", IDC_KEY_HINT, 10, 8, 265, 28
    LTEXT "Up", -1, 12, 43, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST, 57, 39, 74, 20
    LTEXT "Down", -1, 12, 71, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+1, 57, 67, 74, 20
    LTEXT "Left", -1, 12, 99, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+2, 57, 95, 74, 20
    LTEXT "Right", -1, 12, 127, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+3, 57, 123, 74, 20
    LTEXT "A", -1, 12, 155, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+4, 57, 151, 74, 20
    LTEXT "B", -1, 151, 43, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+5, 196, 39, 74, 20
    LTEXT "L", -1, 151, 71, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+6, 196, 67, 74, 20
    LTEXT "R", -1, 151, 99, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+7, 196, 95, 74, 20
    LTEXT "Start", -1, 151, 127, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+8, 196, 123, 74, 20
    LTEXT "Select", -1, 151, 155, 42, 12
    PUSHBUTTON "", IDC_KEY_FIRST+9, 196, 151, 74, 20
    PUSHBUTTON "Defaults", IDC_KEY_DEFAULTS, 12, 195, 66, 22
    DEFPUSHBUTTON "OK", IDOK, 132, 195, 66, 22
    PUSHBUTTON "Cancel", IDCANCEL, 204, 195, 66, 22
END

IDD_LIBRARY DIALOGEX 0, 0, 380, 272
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Game library"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_GAME_FOLDER, 10, 10, 274, 18, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Choose folder...", IDC_GAME_BROWSE, 290, 9, 80, 20
    LISTBOX IDC_GAME_LIST, 10, 36, 360, 182, LBS_NOTIFY | LBS_SORT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT "", IDC_GAME_HINT, 10, 221, 360, 18
    PUSHBUTTON "Refresh", IDC_GAME_REFRESH, 10, 244, 70, 20
    DEFPUSHBUTTON "Play", IDOK, 224, 244, 70, 20
    PUSHBUTTON "Close", IDCANCEL, 300, 244, 70, 20
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GP32emu standalone emulator\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "ProductName", "GP32emu\0"
            VALUE "ProductVersion", "1.0.0\0"
            VALUE "OriginalFilename", "gp32emu_win64.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
