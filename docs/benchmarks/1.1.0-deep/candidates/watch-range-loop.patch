diff --git a/src/arm920t.c b/src/arm920t.c
index 1adec50..8d0fb6e 100644
--- a/src/arm920t.c
+++ b/src/arm920t.c
@@ -1972,10 +1972,27 @@ ARM_FORCE_INLINE void arm_jit_track_code(arm920t_t *c, uint32_t pa, unsigned byt
         for (unsigned page = off >> ARM_JIT_CODE_PAGE_SHIFT;
              page <= (last >> ARM_JIT_CODE_PAGE_SHIFT); ++page)
             c->jit_code_pages[page >> 5] |= 1u << (page & 31u);
-        /* A revalidation span may cover many watches, unlike a CPU store. */
-        for (unsigned watch = off >> ARM_JIT_CODE_WATCH_SHIFT;
-             watch <= (last >> ARM_JIT_CODE_WATCH_SHIFT); ++watch)
-            c->jit_code_watches[watch >> 5] |= 1u << (watch & 31u);
+        /* Individual decode fetches keep the one-word path. Revalidation
+         * can prove up to a whole block: set its bitmap words once instead
+         * of repeatedly updating the same word for each instruction. */
+        unsigned first_watch = off >> ARM_JIT_CODE_WATCH_SHIFT;
+        unsigned last_watch = last >> ARM_JIT_CODE_WATCH_SHIFT;
+        if (bytes <= 4u) {
+            for (unsigned watch = first_watch; watch <= last_watch; ++watch)
+                c->jit_code_watches[watch >> 5] |= 1u << (watch & 31u);
+        } else {
+            unsigned first_word = first_watch >> 5, last_word = last_watch >> 5;
+            uint32_t first_mask = UINT32_MAX << (first_watch & 31u);
+            uint32_t last_mask = UINT32_MAX >> (31u - (last_watch & 31u));
+            if (first_word == last_word) {
+                c->jit_code_watches[first_word] |= first_mask & last_mask;
+            } else {
+                c->jit_code_watches[first_word] |= first_mask;
+                for (unsigned word = first_word + 1u; word < last_word; ++word)
+                    c->jit_code_watches[word] = UINT32_MAX;
+                c->jit_code_watches[last_word] |= last_mask;
+            }
+        }
     }
 }
 
