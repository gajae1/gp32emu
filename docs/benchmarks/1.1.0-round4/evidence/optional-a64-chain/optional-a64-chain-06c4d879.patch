diff --git a/tests/arm_chain_way_test.c b/tests/arm_chain_way_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..da30e94013334b3eb23f5b6b9c37d9a79fe017e7
--- /dev/null
+++ b/tests/arm_chain_way_test.c
@@ -0,0 +1,104 @@
+/* Optional two-way A64 native chaining experiment. This checks semantic and
+ * structural effects; QEMU timing is deliberately not a device benchmark. */
+#define main arm_jit_differential_main
+#include "arm_jit_test.c"
+#undef main
+
+#if defined(ARM_JIT_NATIVE_A64) && ARM_JIT_A64_LINK
+#define TARGET_PC (CODE_ADDR + 0x400u)
+static arm_jit_block_t *target_block;
+static uint32_t decoy_pc;
+static unsigned cases;
+
+static void setup_chain(unsigned second_way) {
+    setup_pair();
+    arm920t_set_trace(cpu_ref, 1, NULL, NULL);
+    const uint32_t head[] = {0xe2800001u, 0xe1a0f008u}; /* ADD r0,#1; MOV pc,r8 */
+    load_both(head, 2u);
+    set_mem_both(TARGET_PC, 0xe2811003u); /* ADD r1,r1,#3 */
+    set_mem_both(TARGET_PC + 4u, 0xe1a0f009u); /* MOV pc,r9 */
+    set_reg_both(8u, TARGET_PC); set_reg_both(9u, CODE_ADDR);
+    set_cpsr_both(0xd3u);
+    CHECK(arm_jit_block_index(CODE_ADDR) != arm_jit_block_index(TARGET_PC), "source uses a different cache set");
+    decoy_pc = 0u;
+    if (second_way) {
+        for (uint32_t pc = 0x1000u; pc < BIOS_SIZE - 8u; pc += 4u) {
+            if (arm_jit_block_index(pc) == arm_jit_block_index(TARGET_PC)) { decoy_pc = pc; break; }
+        }
+        CHECK(decoy_pc != 0u, "found a real hash collision");
+        set_mem_both(decoy_pc, 0xe28aa007u); /* unrelated ADD r10,r10,#7 */
+        set_mem_both(decoy_pc + 4u, 0xe1a0f00bu); /* MOV pc,r11 */
+        prepare_native_block(cpu_jit, decoy_pc);
+    }
+    prepare_native_block(cpu_jit, TARGET_PC);
+    prepare_native_block(cpu_jit, CODE_ADDR);
+    target_block = &cpu_jit->jit_blocks[arm_jit_block_index(TARGET_PC) + second_way];
+    CHECK(target_block->valid && target_block->tag_pc == TARGET_PC && target_block->native_ok == 1u &&
+          target_block->native && target_block->count == 2u, "target resides in requested way and is native");
+    if (second_way) CHECK(target_block[-1].tag_pc == decoy_pc && target_block[-1].valid, "first way remains a valid colliding block");
+    arm920t_reset_cpu_profile(cpu_jit);
+}
+
+static void case_chain(unsigned second_way, uint32_t budget) {
+    current_case = second_way ? "A64-second-way-chain" : "A64-first-way-control";
+    setup_chain(second_way);
+    CHECK(arm920t_run(cpu_jit, budget) == budget && arm920t_run(cpu_ref, budget) == budget, "ragged run budget");
+    compare_state();
+    if (budget >= 4u && !(budget & 1u)) {
+        gp32_cpu_profile_t p;
+        arm920t_get_cpu_profile(cpu_jit, &p);
+        CHECK(p.native_block_calls == 1u, "one native entry covers the ready successor chain");
+        CHECK(p.native_chain_hops == budget / 2u - 1u, "every ready successor chains inside the native frame");
+        printf("chain way=%u budget=%u calls=%" PRIu64 " hops=%" PRIu64 " native=%" PRIu64 "\n",
+               second_way, budget, p.native_block_calls, p.native_chain_hops, p.native_arm_insns);
+    }
+    teardown_pair(); ++cases;
+}
+
+static void case_guard(unsigned mutation) {
+    current_case = "A64-second-way-rejection-guard";
+    setup_chain(1u);
+    uint32_t budget = 8u;
+    switch (mutation) {
+    case 0: target_block->valid = 0u; break;
+    case 1: target_block->generation--; break;
+    case 2: target_block->tag_cache_epoch--; break;
+    case 3: target_block->native_ok = 4u; target_block->native = NULL; break;
+    case 4: target_block->poll_backedge = 2u; break;
+    case 5: target_block->deferred_inline_pc = TARGET_PC + 0x80u; break;
+    case 6: budget = 3u; break;
+    case 7: arm920t_set_irq(cpu_jit, 1); break; /* masked line still conservatively rejects a hop */
+    case 8: arm920t_set_fiq(cpu_jit, 1); break;
+    case 9: target_block->tag_pc = decoy_pc; break;
+    }
+    arm_jit_block_t *head = &cpu_jit->jit_blocks[arm_jit_block_index(CODE_ADDR)];
+    if (!head->native) {
+        CHECK(0, "source must have a native entry before a direct-entry guard test");
+        teardown_pair(); ++cases; return;
+    }
+    /* Exercise one generated entry directly so a later dispatcher repair
+     * cannot hide an unsafe hop. Normal architectural execution is checked
+     * separately above via arm920t_run and the raw interpreter. */
+    uint32_t done = head->native(cpu_jit, budget);
+    CHECK(done == 2u && arm920t_get_pc(cpu_jit) == TARGET_PC, "unsafe successor returns after source block");
+    CHECK(arm920t_get_reg(cpu_jit, 0u) == 1u && arm920t_get_reg(cpu_jit, 1u) == 0u,
+          "rejected target performs no guest mutation");
+    gp32_cpu_profile_t p; arm920t_get_cpu_profile(cpu_jit, &p);
+    CHECK(p.native_chain_hops == 0u, "rejected successor never chains");
+    teardown_pair(); ++cases;
+}
+#endif
+
+int main(void) {
+#if defined(ARM_JIT_NATIVE_A64) && ARM_JIT_A64_LINK
+    const uint32_t budgets[] = {1u, 2u, 3u, 4u, 5u, 8u, 19u, 64u, 257u, 1000u};
+    for (unsigned way = 0; way < 2u; ++way)
+        for (unsigned i = 0; i < GP32_ARRAY_COUNT(budgets); ++i) case_chain(way, budgets[i]);
+    for (unsigned mutation = 0; mutation < 10u; ++mutation) case_guard(mutation);
+    if (failures) { fprintf(stderr, "A64 chain ways: %u cases, %d failures\n", cases, failures); return 1; }
+    printf("PASS: %u A64 chain way, budget and rejection scenarios\n", cases);
+#else
+    puts("SKIP: requires A64 linked native execution");
+#endif
+    return 0;
+}
