<?xml version="1.0" encoding="UTF-8"?>
<systemList>
    <system>
        <name>gp32</name>
        <fullname>Game Park GP32</fullname>
        <path>%ROMPATH%/gp32</path>
        <extension>.smc .SMC .fxe .FXE .fpk .FPK</extension>
        <command label="GP32emu">%EMULATOR_RETROARCH% %EXTRA_CONFIGFILE%=%EXTERNALDATA%/Android/data/%ANDROIDPACKAGE%/files/retroarch.cfg %EXTRA_LIBRETRO%=%INTERNALDATA%/%ANDROIDPACKAGE%/cores/gp32emu_libretro_android.so %EXTRA_ROM%=%ROM%</command>
        <platform>ignore</platform>
        <theme>gp32</theme>
    </system>
</systemList>
